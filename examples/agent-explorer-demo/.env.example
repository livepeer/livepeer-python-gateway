# PymtHouse base URL (no trailing slash). Local default matches Next.js port.
PYMTHOUSE_BASE_URL=http://localhost:3001

# Optional: override remote signer / discovery embedded in sdk_token.
# Use production signer while keeping PYMTHOUSE_BASE_URL on local register/MCP.
# SIGNER_URL=https://signer.pymthouse.com
# DISCOVERY_URL=https://signer.pymthouse.com/discover-orchestrators

# Optional: pin orchestrator host:port. If unset, sdk_token discovery / MCP query is used.
# ORCHESTRATOR=127.0.0.1:8935

# LV2V model. Local noop only works with a local signer/orch; production uses
# streamdiffusion-sdxl (see discover-orchestrators caps).
MODEL_ID=noop

# Demo state directory (keys, apiKey, signer session). Relative to CWD or absolute.
AGENT_STATE_DIR=.agent-demo

# Alchemy session wallet instance name (parallel onchain/x402 identity).
ALCHEMY_INSTANCE_NAME=agent-explorer-demo

# Preferred EVM network for Agent Wallet RPC/balance checks (CLI -n slug).
# Agent Wallets support Arbitrum One + Sepolia. Default matches PymtHouse Livepeer.
# Slugs: arb-mainnet (42161), arb-sepolia (421614). Also arbnova-mainnet.
ALCHEMY_NETWORK=arb-mainnet

# Optional label stored on PymtHouse register.
AGENT_LABEL=agent-explorer-demo

# Frame burst for the demo LV2V job.
JOB_WIDTH=320
JOB_HEIGHT=180
JOB_FPS=30
JOB_FRAME_COUNT=30
